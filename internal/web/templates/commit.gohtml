{{define "title"}}{{.Commit.Subject}}{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <h1 class="heading-page">{{.Commit.Subject}}</h1>
  {{template "stale" .Stale}}
  {{- if .Commit.Body}}<pre class="commit-message prose">{{.Commit.Body}}</pre>{{end}}
  <div class="panel stack">
    <dl class="facts">
      <dt>Author</dt><dd>{{.Commit.Author}} &lt;{{.Commit.Email}}&gt; · <span title="{{.Commit.WhenExact}}">{{.Commit.WhenExact}}</span></dd>
      {{- if .Commit.Committer}}
      <dt>Committer</dt><dd>{{.Commit.Committer}} &lt;{{.Commit.CommitterEmail}}&gt; · <span title="{{.Commit.CommitterWhen}}">{{.Commit.CommitterWhen}}</span></dd>
      {{- end}}
      <dt>Commit</dt><dd>{{.Commit.SHA}}</dd>
      {{- if .Parents}}
      <dt>{{if gt (len .Parents) 1}}Parents{{else}}Parent{{end}}</dt>
      <dd>{{range .Parents}}<a href="{{.URL}}">{{.Short}}</a> {{end}}{{if gt (len .Parents) 1}}<span class="meta">merge commit; the diff is against the first parent</span>{{end}}</dd>
      {{- end}}
      {{- range .Trailers}}
      <dt>{{.Key}}</dt><dd>{{.Value}}</dd>
      {{- end}}
    </dl>
    <p class="meta"><a href="{{.TreeURL}}">Browse tree at {{.Commit.Short}}</a> · <a href="{{.PatchURL}}">Download patch</a>{{if .ExpandURL}} · <a href="{{.ExpandURL}}">Open every file</a>{{end}}{{if .CollapseURL}} · <a href="{{.CollapseURL}}">Shut the large files</a>{{end}}</p>
  </div>

  {{- if .Root}}
  <div class="panel"><p class="empty">This is the first commit in the repository. There is no diff. <a href="{{.TreeURL}}">Browse tree</a>.</p></div>
  {{- else}}
  <div class="panel stack">
    <div class="diffstat">
      {{- with .Stats}}
      <span>{{.Files}} files changed</span>
      <span class="count-add">{{.Additions}}</span>
      <span class="count-del">{{.Deletions}}</span>
      {{- end}}
      {{- if .Patch.OverBudget}}<span class="meta">{{.Patch.OverBudget}} too large to render inline</span>{{end}}
    </div>
    {{- if .Single}}
    <p class="notice">Showing one file. <a href="{{.Commit.URL}}">Show the full diff</a>.</p>
    {{- end}}
    {{- if .Truncated}}
    <p class="notice"><strong>This diff is truncated.</strong> Open a file on its own from its row, or download the patch.</p>
    {{- end}}
  </div>
  {{template "difffiles" .Files}}
  {{- end}}
  {{template "copy" .Copy}}
</main>
{{end}}
