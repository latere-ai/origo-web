{{define "title"}}{{.Name}}{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <h1 class="heading-path">{{.Name}}</h1>
  <p class="crumbs"><a href="{{.Repo.URL}}/tree/{{.Repo.RefQuery}}">{{.Repo.Slug}}</a>{{range .Crumbs}} / {{if .URL}}<a href="{{.URL}}">{{.Name}}</a>{{else}}<span class="here">{{.Name}}</span>{{end}}{{end}}</p>
  {{- with .Pin}}
  <p class="pin">
    <span class="refname">{{if .Pinned}}pinned {{end}}{{.Ref}}</span>
    <span class="hint">{{.Note}}</span>
    <a href="{{.URL}}">{{.Link}}</a>
  </p>
  {{- end}}
  {{template "stale" .Stale}}
  <div class="panel flush">
    <div class="panel-head">
      <span class="meta"><span class="size">{{.Size}}</span>{{if .LineCount}} · {{.LineCount}} lines{{end}} · {{.Type}} · mode <span class="mono">{{.Mode}}</span></span>
      <span><a href="{{.RawURL}}">raw</a> · <a href="{{.HistoryURL}}">history</a></span>
    </div>
    {{- if .TooLarge}}
    <div class="notice">
      <p><strong>This file is too large to show here.</strong> It is {{.Size}}.</p>
      <p><a href="{{.RawURL}}">Download it</a> or clone the repository: <span class="mono">git clone {{.CloneHTTPS}}</span></p>
    </div>
    {{- else if .Binary}}
    <div class="notice">
      <p><strong>Binary file.</strong> {{.Size}}, {{.Type}}.</p>
      <p><a href="{{.RawURL}}">Download it</a> · <a href="{{.HistoryURL}}">History</a></p>
    </div>
    {{- else}}
      {{- if .Truncated}}
      <div class="notice">
        <p><strong>Only the first part of this file is shown.</strong> The whole file is {{.Size}}.</p>
        <p><a href="{{.RawURL}}">Download the whole file</a> or clone the repository: <span class="mono">git clone {{.CloneHTTPS}}</span></p>
      </div>
      {{- end}}
      {{- if .Lines}}
      <div class="scroller">
        <table class="source">
          <caption class="visually-hidden">Source of {{.Path}}</caption>
          <tbody>
          {{- range .Lines}}
            <tr id="L{{.N}}"><td class="gutter"><a href="#L{{.N}}">{{.N}}</a></td><td>{{.Text}}</td></tr>
          {{- end}}
          </tbody>
        </table>
      </div>
      {{- else}}
      <p class="empty">This file is empty.</p>
      {{- end}}
    {{- end}}
  </div>
  {{template "copy" .Copy}}
</main>
{{end}}
