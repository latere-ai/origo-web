{{define "title"}}New repository{{end}}
{{define "main"}}
<main class="stack">
  <h1 class="heading-page">New repository</h1>
  <p class="lead">Creates an empty repository. Nothing is imported.</p>

  {{- if .Error}}
  <p class="notice" role="alert">{{.Error}}</p>
  {{- end}}

  {{- if .Owners}}
  <form class="panel stack" action="/new" method="post">
    <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
    <div class="fields stacked">
      <fieldset class="field">
        <legend>Owner</legend>
        <div class="choices scrolling">
          {{- range .Owners}}
          <div class="choice">
            <input id="owner-{{.Label}}" type="radio" name="owner" value="{{.Label}}"{{if eq .Label $.Form.Owner}} checked{{end}} required>
            <label for="owner-{{.Label}}"><span class="option-title">{{.Label}}</span><span class="option-note">{{if .Remaining}}{{.Name}}, {{.Remaining}} more allowed{{else}}{{.Name}}, limit reached{{end}}</span></label>
          </div>
          {{- end}}
        </div>
        <span class="hint">Your account and the organisations you administer.</span>
      </fieldset>

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" class="mono" value="{{.Form.Name}}" maxlength="64" placeholder="my-project" required>
        <span class="hint">Letters, digits, . _ and -, up to 64 characters.</span>
      </div>
    </div>
    <div class="row">
      <button class="button-primary" type="submit">Create repository</button>
    </div>
  </form>
  {{- else}}
  <div class="panel stack">
    <h2 class="heading-section">No owner available</h2>
    <p class="prose">A repository belongs to an account name or an organisation you administer. {{if .View.Who}}{{.View.Who}} has neither.{{end}}</p>
    {{- if .AccountURL}}
    <p class="prose">Claim a name in your account settings, then return here. <a href="{{.AccountURL}}">Go to your account</a>.</p>
    {{- else}}
    <p class="prose">Ask your administrator for a name.</p>
    {{- end}}
  </div>
  {{- end}}
</main>
{{end}}
