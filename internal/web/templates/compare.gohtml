{{define "title"}}Compare{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <h1 class="heading-page">Compare</h1>
  {{template "stale" .Stale}}
  <div class="panel stack">
    <form class="inline-form" action="{{.Repo.URL}}/compare" method="get">
      <div class="field"><label for="base">Base</label><input id="base" name="base" class="mono" size="20" value="{{.Base}}" required></div>
      <div class="field"><label for="head">Head</label><input id="head" name="head" class="mono" size="20" value="{{.Head}}" required></div>
      <button type="submit">Compare</button>
    </form>
    <p class="meta">A branch, a tag or a commit id on either side.</p>
  </div>
  {{- if .Ready}}
  <div class="panel stack">
    <div class="diffstat">
      <span>{{len .Patch.Files}} files changed</span>
      <span class="count-add">{{.Patch.Additions}}</span>
      <span class="count-del">{{.Patch.Deletions}}</span>
    </div>
    {{- if .Truncated}}
    <p class="notice"><strong>This diff is truncated.</strong> Open a file on its own from its row.</p>
    {{- end}}
  </div>
  {{template "difffiles" .Files}}
  {{- end}}
</main>
{{end}}
