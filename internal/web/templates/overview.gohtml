{{define "title"}}{{.Repo.Owner}}/{{.Repo.Slug}}{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <div class="repo-head">
    <div class="spread">
      <h1 class="heading-path">{{.Repo.Owner}} <span class="muted">/</span> {{.Repo.Slug}}</h1>
      <p class="repo-facts">
        <a href="{{.Repo.URL}}/log{{.Repo.RefQuery}}">commit log</a>
        <a href="{{.Repo.URL}}/refs">{{.Branches}} {{if eq .Branches 1}}branch{{else}}branches{{end}}</a>
        <a href="{{.Repo.URL}}/refs#tags">{{.Tags}} {{if eq .Tags 1}}tag{{else}}tags{{end}}</a>
        <span class="size">{{.Repo.Size}}</span>
        {{- if .Repo.Pushed}}<span title="{{.Repo.PushedExact}}">pushed {{.Repo.Pushed}}</span>{{end}}
        {{- if eq .Visibility "public"}}<span class="badge">public</span>{{end}}
        {{- if eq .Visibility "private"}}<span class="badge badge-quiet">private</span>{{end}}
        {{- if eq .Visibility "unknown"}}<span class="badge badge-quiet">visibility unavailable</span>{{end}}
        {{- if .VisibilityURL}}<a href="{{.VisibilityURL}}">change visibility</a>{{end}}
        {{- if .DeleteURL}}<a href="{{.DeleteURL}}">delete</a>{{end}}
        {{- if .Repo.Frozen}}<strong>frozen, read-only</strong>{{end}}
        {{- if .ArchiveURL}}<a href="{{.ArchiveURL}}">download tar.gz</a>{{end}}
      </p>
    </div>
    <div class="repo-controls">
      {{- if not .Selector.Empty}}
      <form action="{{.Selector.Action}}" method="get">
        <details class="picker">
          <summary><span class="label">Ref</span> <span class="refname">{{.Selector.Ref}}</span></summary>
          <div class="picker-body">
            <fieldset class="field">
              <legend>Branch or tag</legend>
              <div class="choices scrolling">
                {{- range .Selector.Branches}}
                <div class="choice">
                  <input id="ref-branch-{{.Short}}" type="radio" name="ref" value="{{.Short}}"{{if eq .Short $.Selector.Ref}} checked{{end}}>
                  <label for="ref-branch-{{.Short}}"><span class="option-title">{{.Short}}</span><span class="option-note">branch</span></label>
                </div>
                {{- end}}
                {{- range .Selector.Tags}}
                <div class="choice">
                  <input id="ref-tag-{{.Short}}" type="radio" name="ref" value="{{.Short}}"{{if eq .Short $.Selector.Ref}} checked{{end}}>
                  <label for="ref-tag-{{.Short}}"><span class="option-title">{{.Short}}</span><span class="option-note">tag</span></label>
                </div>
                {{- end}}
              </div>
            </fieldset>
            <div class="row">
              <button type="submit">Go</button>
              <a href="{{.Repo.URL}}/refs">all references</a>
            </div>
          </div>
        </details>
      </form>
      {{- end}}
      <div class="clone">
        {{- if .CloneSSH}}
        <nav class="clone-tabs" aria-label="Clone address">
          <a href="{{.Repo.URL}}{{.Repo.RefQuery}}"{{if not .CloneIsSSH}} aria-current="page"{{end}}>HTTPS</a>
          <a href="{{.CloneSSHURL}}"{{if .CloneIsSSH}} aria-current="page"{{end}}>SSH</a>
        </nav>
        {{- end}}
        <div class="clone-row">
          <label class="visually-hidden" for="clone">Clone address</label>
          <input id="clone" class="mono" readonly value="{{if .CloneIsSSH}}{{.CloneSSH}}{{else}}{{.CloneHTTPS}}{{end}}">
        </div>
        {{- /* What git will ask for at this address, because git asks
             without saying why: a password over HTTPS, which is a token,
             and a key over SSH, which is one registered to the account. */ -}}
        <p class="hint">
          {{- if .CloneIsSSH}}SSH uses {{if .View.KeysEnabled}}<a href="/keys">a key on your account</a>{{else}}a key on your account{{end}}.
          {{- else if eq .Visibility "public"}}Anyone can clone this address. Pushing asks for a password: use an <a href="/tokens?repo={{.Repo.ID}}">agent token</a>, with any username.
          {{- else}}Git asks for a password: use an <a href="/tokens?repo={{.Repo.ID}}">agent token</a>, with any username.
          {{- end}}
        </p>
      </div>
    </div>
  </div>
  {{template "stale" .Stale}}

  {{- if .Empty}}
  <div class="panel">
    <p class="empty">This repository has no commits yet. Push to the clone address above.</p>
  </div>
  {{- else}}

  <div class="panel flush">
    {{- with .Last}}
    <div class="panel-head">
      <a class="sha" href="{{.URL}}">{{.Short}}</a>
      <span class="subject">{{.Subject}}</span>
      <span class="meta">{{.Author}} · <span title="{{.WhenExact}}">{{.When}}</span></span>
    </div>
    {{- end}}
    <div class="scroller">
      <table class="stackable">
        <caption>Files at {{.Repo.Ref}}</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col" class="num">Size</th>
          </tr>
        </thead>
        <tbody>
        {{- range .Entries}}
          <tr>
            <th scope="row" class="path"><a href="{{.URL}}">{{.Name}}</a></th>
            <td data-label="Type" class="meta">{{.Type}}</td>
            <td data-label="Size" class="num size">{{.Size}}</td>
          </tr>
        {{- else}}
          <tr><td colspan="3" class="empty">No files.</td></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- if .TreeCursor}}
  <nav class="pager" aria-label="Pages"><span class="inert">More files in this directory</span><a href="{{.Repo.URL}}/tree/?cursor={{.TreeCursor}}">Next page</a></nav>
  {{- end}}

  {{- with .Readme}}
  <div class="panel flush">
    <div class="panel-head">
      <span class="path">{{.Name}}</span>
      <a href="{{.URL}}">view file</a>
    </div>
    {{- if .HTML}}
    <div class="readme prose">{{.HTML}}</div>
    {{- else if .Text}}
    <div class="readme prose"><pre>{{.Text}}</pre></div>
    {{- else}}
    <div class="readme prose"><p class="meta">The readme is too large to show here. <a href="{{.URL}}">Open it as a file</a>.</p></div>
    {{- end}}
  </div>
  {{- end}}
  {{- end}}
</main>
{{end}}
