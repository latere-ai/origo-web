{{define "title"}}Agent tokens{{end}}
{{define "main"}}
<main class="stack">
  <h1 class="heading-page">Agent tokens</h1>
  <p class="lead">A token lets an agent act as you inside one repository until it expires. It opens no other repository and no screen here. <a href="/docs/agents">How an agent uses one</a>.</p>

  {{- if .Error}}
  <p class="notice" role="alert"><strong>That did not work.</strong> {{.Error}}</p>
  {{- end}}

  <form class="panel stack" action="/tokens" method="post">
    <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
    <h2 class="heading-section">Mint a token</h2>
    <div class="fields">
      {{- if .Directory}}
      <fieldset class="field">
        <legend>Repository</legend>
        <div class="choices scrolling">
          {{- range .Repos}}
          <div class="choice">
            <input id="repo-{{.ID}}" type="radio" name="repo" value="{{.ID}}"{{if eq .ID $.Form.Repo}} checked{{end}} required>
            <label for="repo-{{.ID}}"><span class="option-title">{{.Owner}}/{{.Name}}</span><span class="option-note">{{.ID}}</span></label>
          </div>
          {{- end}}
        </div>
        <span class="hint">Exactly one. Two repositories means two tokens.</span>
      </fieldset>
      {{- else}}
      <div class="field">
        <label for="repo">Repository</label>
        <input id="repo" name="repo" class="mono" value="{{.Form.Repo}}" placeholder="the identifier your administrator gave you" required>
        <span class="hint">Exactly one. Two repositories means two tokens.</span>
      </div>
      {{- end}}

      <fieldset class="field">
        <legend>Scope</legend>
        <div class="choices">
          <div class="choice">
            <input id="scope-read" type="radio" name="scope" value="read"{{if ne .Form.Scope "write"}} checked{{end}}>
            <label for="scope-read"><span class="option-title">read</span><span class="option-note">clone, log, tree, file</span></label>
          </div>
          <div class="choice">
            <input id="scope-write" type="radio" name="scope" value="write"{{if eq .Form.Scope "write"}} checked{{end}}>
            <label for="scope-write"><span class="option-title">write</span><span class="option-note">everything read does, and push</span></label>
          </div>
        </div>
        <span class="hint">Neither scope can administer the repository.</span>
      </fieldset>

      <fieldset class="field">
        <legend>Lifetime</legend>
        <div class="choices">
          {{- range .Lifetimes}}
          <div class="choice">
            <input id="ttl-{{.Seconds}}" type="radio" name="ttl" value="{{.Seconds}}"{{if eq .Seconds $.Form.TTL}} checked{{end}}>
            <label for="ttl-{{.Seconds}}"><span class="option-title">{{.Label}}</span><span class="option-note">{{.Note}}</span></label>
          </div>
          {{- end}}
        </div>
        <span class="hint">Choose the shortest that covers the job.</span>
      </fieldset>
    </div>
    <div class="row">
      <button class="button-primary" type="submit">Mint token</button>
      <span class="hint">Shown once, on the page that follows.</span>
    </div>
  </form>

  {{- if .Registry}}
  <div class="panel flush">
    <div class="scroller">
      <table class="stackable">
        <caption>Tokens minted for {{if .Repo}}{{.Repo.Owner}}/{{.Repo.Slug}}{{else}}this repository{{end}}</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Scope</th>
            <th scope="col">Minted</th>
            <th scope="col">Expires</th>
            <th scope="col">Last used</th>
          </tr>
        </thead>
        <tbody>
        {{- range .Tokens}}
          <tr>
            <th scope="row" class="sha">{{.ID}}{{if .Revoked}} <span class="meta">withdrawn {{.Withdrawn}}</span>{{end}}</th>
            <td data-label="Scope" class="refname">{{.Scope}}</td>
            <td data-label="Minted" class="when">{{.Issued}}</td>
            <td data-label="Expires" class="when">{{.Expires}}</td>
            <td data-label="Last used" class="when">{{if .LastUsed}}{{.LastUsed}}{{else}}never used{{end}}</td>
          </tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- else}}
  <div class="panel stack">
    <h2 class="heading-section">No list of tokens</h2>
    <p class="prose">This server signs a token and does not record it. There is nothing to list and no way to withdraw one. A token ends when its lifetime ends.</p>
    <p class="prose">If one reaches somebody it should not: wait for it to expire, and ask whoever administers this installation to change the repository's access. <a href="/docs/agents">Why it works this way</a>.</p>
  </div>
  {{- end}}

  {{- if .Recent}}
  <div class="panel flush">
    <div class="scroller">
      <table class="stackable">
        <caption>Opened in this session</caption>
        <thead><tr><th scope="col">Repository</th></tr></thead>
        <tbody>
        {{- range .Recent}}
          <tr><th scope="row" class="path"><a href="{{.URL}}">{{.Name}}</a></th></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- end}}
</main>
{{end}}
