{{define "title"}}Agent tokens{{end}}
{{define "main"}}
<main class="stack">
  <h1 class="heading-page">Agent tokens</h1>
  <p class="lead">A token gives an agent access to one repository until it expires. <a href="/docs/agents">Usage</a>.</p>

  {{- if .Error}}
  <p class="notice" role="alert">{{.Error}}</p>
  {{- end}}

  <form class="panel stack" action="/tokens" method="post">
    <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
    <h2 class="heading-section">Create a token</h2>
    <div class="fields">
      {{- if .Directory}}
      <fieldset class="field">
        <legend>Repository</legend>
        <div class="choices scrolling">
          {{- range .Repos}}
          <div class="choice">
            <input id="repo-{{.ID}}" type="radio" name="repo" value="{{.ID}}"{{if eq .ID $.Form.Repo}} checked{{end}} required>
            <label for="repo-{{.ID}}"><span class="option-title">{{.Owner}}/{{.Name}}</span><span class="option-note">{{.ID}}</span></label>
          </div>
          {{- end}}
        </div>
        <span class="hint">One repository per token.</span>
      </fieldset>
      {{- else}}
      <div class="field">
        <label for="repo">Repository</label>
        <input id="repo" name="repo" class="mono" value="{{.Form.Repo}}" placeholder="repository identifier" required>
        <span class="hint">One repository per token.</span>
      </div>
      {{- end}}

      <fieldset class="field">
        <legend>Scope</legend>
        <div class="choices">
          <div class="choice">
            <input id="scope-read" type="radio" name="scope" value="read"{{if ne .Form.Scope "write"}} checked{{end}}>
            <label for="scope-read"><span class="option-title">read</span><span class="option-note">clone and read</span></label>
          </div>
          <div class="choice">
            <input id="scope-write" type="radio" name="scope" value="write"{{if eq .Form.Scope "write"}} checked{{end}}>
            <label for="scope-write"><span class="option-title">write</span><span class="option-note">read and push</span></label>
          </div>
        </div>
        <span class="hint">Neither scope grants admin access.</span>
      </fieldset>

      <fieldset class="field">
        <legend>Lifetime</legend>
        <div class="choices">
          {{- range .Lifetimes}}
          <div class="choice">
            <input id="ttl-{{.Seconds}}" type="radio" name="ttl" value="{{.Seconds}}"{{if eq .Seconds $.Form.TTL}} checked{{end}}>
            <label for="ttl-{{.Seconds}}"><span class="option-title">{{.Label}}</span><span class="option-note">{{.Note}}</span></label>
          </div>
          {{- end}}
        </div>
        <span class="hint">Choose the shortest that fits.</span>
      </fieldset>
    </div>
    <div class="row">
      <button class="button-primary" type="submit">Create token</button>
      <span class="hint">Shown once, on the next page.</span>
    </div>
  </form>

  {{- if .Registry}}
  <div class="panel flush">
    <div class="scroller">
      <table class="stackable">
        <caption>Tokens for {{if .Repo}}{{.Repo.Owner}}/{{.Repo.Slug}}{{else}}this repository{{end}}</caption>
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Scope</th>
            <th scope="col">Created</th>
            <th scope="col">Expires</th>
            <th scope="col">Last used</th>
          </tr>
        </thead>
        <tbody>
        {{- range .Tokens}}
          <tr>
            <th scope="row" class="sha">{{.ID}}{{if .Revoked}} <span class="meta">revoked {{.Withdrawn}}</span>{{end}}</th>
            <td data-label="Scope" class="refname">{{.Scope}}</td>
            <td data-label="Created" class="when">{{.Issued}}</td>
            <td data-label="Expires" class="when">{{.Expires}}</td>
            <td data-label="Last used" class="when">{{if .LastUsed}}{{.LastUsed}}{{else}}never used{{end}}</td>
          </tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- else}}
  <div class="panel stack">
    <h2 class="heading-section">Tokens are not listed</h2>
    <p class="prose">The server does not store tokens, so they cannot be listed or revoked. A token expires at the end of its lifetime.</p>
    <p class="prose">If a token leaks, wait for it to expire or ask an administrator to change the repository's access. <a href="/docs/agents">Details</a>.</p>
  </div>
  {{- end}}

  {{- if .Recent}}
  <div class="panel flush">
    <div class="scroller">
      <table class="stackable">
        <caption>Opened in this session</caption>
        <thead><tr><th scope="col">Repository</th></tr></thead>
        <tbody>
        {{- range .Recent}}
          <tr><th scope="row" class="path"><a href="{{.URL}}">{{.Name}}</a></th></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- end}}
</main>
{{end}}
