{{define "title"}}Repositories{{end}}
{{define "main"}}
<main class="stack">
  <div class="spread">
    <h1 class="heading-page">Repositories</h1>
    {{- if and .View.SignedIn .View.CanCreate}}
    <a class="button" href="/new">New repository</a>
    {{- end}}
  </div>
  {{- if .Deleted}}
  <p class="notice"><strong>{{.Deleted}} was deleted.</strong> The name is free to use again.</p>
  {{- end}}
  {{template "stale" .Stale}}
  {{- if .Directory}}
    {{- if .Owners}}
    <div class="spread">
      <p class="hint">{{.Count}} {{if eq .Count 1}}repository{{else}}repositories{{end}} across {{len .Owners}} {{if eq (len .Owners) 1}}owner{{else}}owners{{end}}.</p>
      {{- if .CanFilter}}
      <form class="inline-form" action="/" method="get">
        <div class="field">
          <label for="q">Filter by name</label>
          <input id="q" name="q" type="search" class="mono" value="{{.Query}}" placeholder="name or owner">
        </div>
        <button type="submit">Filter</button>
      </form>
      {{- end}}
    </div>
    {{- range .Owners}}
    <div class="panel flush">
      <div class="scroller">
        <table class="stackable">
          <caption>{{.Owner}}, {{len .Repos}} {{if eq (len .Repos) 1}}repository{{else}}repositories{{end}}</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Last pushed</th>
              <th scope="col" class="num">Size</th>
              <th scope="col">Default branch</th>
            </tr>
          </thead>
          <tbody>
          {{- range .Repos}}
            <tr>
              <th scope="row" class="path"><a href="{{.URL}}">{{.Name}}</a></th>
              <td data-label="Last pushed" class="when"><span title="{{.PushedExact}}">{{.Pushed}}</span></td>
              <td data-label="Size" class="size num">{{.Size}}</td>
              <td data-label="Default branch" class="refname">{{.DefaultBranch}}</td>
            </tr>
          {{- end}}
          </tbody>
        </table>
      </div>
    </div>
    {{- end}}
    {{- if .Next}}<nav class="pager" aria-label="Pages"><span class="inert">Newer</span><a href="/?cursor={{.Next}}">More repositories</a></nav>{{end}}
    {{- else if .Query}}
    <div class="panel"><p class="empty">No repository matches {{.Query}}. <a href="/">Show all</a></p></div>
    {{- else}}
    <div class="panel"><p class="empty">No repositories yet.{{if .View.Who}} Signed in as {{.View.Who}}.{{end}}</p></div>
    {{- end}}
  {{- else}}
  <div class="panel stack">
    <h2 class="heading-section">This installation does not list repositories</h2>
    <p class="prose">Enter a repository as owner/name, or its identifier, to open it. Repositories opened in this session are listed below.</p>
    {{- if .View.Who}}
    <p class="hint">Signed in as {{.View.Who}}.</p>
    {{- end}}
    <form class="inline-form" action="/open" method="get">
      <div class="field">
        <label for="id">Repository</label>
        <input id="id" name="id" class="mono" size="40" placeholder="owner/name" required>
      </div>
      <button type="submit">Open</button>
    </form>
  </div>
  {{- end}}
  {{- if .Recent}}
  <div class="panel flush">
    <div class="scroller">
      <table class="stackable">
        <caption>Opened in this session</caption>
        <thead><tr><th scope="col">Repository</th></tr></thead>
        <tbody>
        {{- range .Recent}}
          <tr><th scope="row" class="path"><a href="{{.URL}}">{{.Name}}</a></th></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </div>
  {{- end}}
</main>
{{end}}
