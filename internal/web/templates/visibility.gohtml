{{define "title"}}{{.Repo.Owner}}/{{.Repo.Slug}}{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <h1 class="heading-page">Visibility of {{.Repo.Owner}}/{{.Repo.Slug}}</h1>

  {{- if .Error}}
  <p class="notice" role="alert">{{.Error}}</p>
  {{- end}}

  {{- if .Public}}
  <p class="lead">This repository is public. Anyone can read and clone it without an account.</p>
  <div class="panel stack">
    <h2 class="heading-section">Make it private</h2>
    <p>Only people with access can read it.</p>
    <p>Existing clones are not affected.</p>
    <form action="{{.Repo.URL}}/visibility" method="post">
      <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
      <input type="hidden" name="visibility" value="{{.Target}}">
      <div class="row">
        <button class="button-primary" type="submit">Make private</button>
        <a href="{{.Repo.URL}}">Cancel</a>
      </div>
    </form>
  </div>
  {{- else}}
  <p class="lead">This repository is private. Only people with access can read it.</p>
  <div class="panel stack">
    <h2 class="heading-section">Make it public</h2>
    <p>Anyone can read and clone it without an account.</p>
    <p>All branches, tags and history become readable.</p>
    <p>Pushing still requires access. The repository is not listed publicly.</p>
    <form action="{{.Repo.URL}}/visibility" method="post">
      <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
      <input type="hidden" name="visibility" value="{{.Target}}">
      <div class="row">
        <button class="button-primary" type="submit">Make public</button>
        <a href="{{.Repo.URL}}">Cancel</a>
      </div>
    </form>
  </div>
  {{- end}}
</main>
{{end}}
