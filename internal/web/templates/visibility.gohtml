{{define "title"}}{{.Repo.Owner}}/{{.Repo.Slug}}{{end}}
{{define "main"}}
{{template "repohead" .}}
<main class="stack">
  <h1 class="heading-page">Who can read {{.Repo.Owner}}/{{.Repo.Slug}}</h1>

  {{- if .Error}}
  <p class="notice" role="alert"><strong>That did not work.</strong> {{.Error}}</p>
  {{- end}}

  {{- if .Public}}
  <p class="lead">This repository is public. Anyone can read and clone it. They do not need an account.</p>
  <div class="panel stack">
    <h2 class="heading-section">Make it private</h2>
    <p>Only people you have given access can read this repository.</p>
    <p>Copies that were already cloned stay where they are. Making it private does not delete them.</p>
    <form action="{{.Repo.URL}}/visibility" method="post">
      <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
      <input type="hidden" name="visibility" value="{{.Target}}">
      <div class="row">
        <button class="button-primary" type="submit">Make private</button>
        <a href="{{.Repo.URL}}">Cancel</a>
      </div>
    </form>
  </div>
  {{- else}}
  <p class="lead">This repository is private. Only people you have given access can read it.</p>
  <div class="panel stack">
    <h2 class="heading-section">Make it public</h2>
    <p>Anyone can read and clone this repository. They do not need an account.</p>
    <p>The code, every branch, every tag, and the full history become readable.</p>
    <p>Nobody can push to it without access. It does not appear in any list.</p>
    <form action="{{.Repo.URL}}/visibility" method="post">
      <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
      <input type="hidden" name="visibility" value="{{.Target}}">
      <div class="row">
        <button class="button-primary" type="submit">Make public</button>
        <a href="{{.Repo.URL}}">Cancel</a>
      </div>
    </form>
  </div>
  {{- end}}
</main>
{{end}}
