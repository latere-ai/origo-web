{{define "title"}}New token{{end}}
{{define "main"}}
<main class="stack">
  <p class="crumbs"><a href="/tokens">agent tokens</a> / <span class="here">new</span></p>

  <div class="secret stack prose">
    <h1 class="heading-section">Copy this token now. You will not see it again.</h1>
    <p>The token is not stored. It cannot be recovered after you leave this page.</p>
    <div class="field">
      <label for="token">Token</label>
      <input id="token" class="mono" readonly value="{{.Token}}" size="48">
    </div>
  </div>

  <div class="panel stack">
    <dl class="facts">
      <dt>Repository</dt><dd class="path">{{.Repo.Owner}}/{{.Repo.Slug}}</dd>
      <dt>Scope</dt><dd class="refname">{{.Scope}}</dd>
      <dt>Expires</dt><dd class="when">{{.Expires}}, {{.ExpiresIn}} from now</dd>
    </dl>
    <h2 class="heading-section">Usage</h2>
    <p class="meta">Set it as <code>ORIGO_TOKEN</code> in the agent's environment. Do not commit it or put it in a prompt.</p>
    <pre class="scroller sample">{{.CloneLine}}

{{.ReadLine}}</pre>
    <p><a class="button" href="{{.BackURL}}">Done</a></p>
  </div>
</main>
{{end}}
