{{- define "base" -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{template "title" .}} · {{.View.Product}}</title>
<link rel="stylesheet" href="/assets/app.css">
{{- range .View.Alternates}}
<link rel="alternate" type="{{.Type}}" title="{{.Name}}" href="{{.Href}}">
{{- end}}
<link rel="icon" href="data:,">
</head>
<body>
<div class="page">
  <header class="masthead">
    <a class="brand" href="/">{{if .View.Mark}}{{template "mark"}}{{end}}<span>{{.View.Product}}</span></a>
    <nav aria-label="Site">
      <a href="/"{{if eq .View.Section "home"}} aria-current="page"{{end}}>repositories</a>
      {{- if .View.KeysEnabled}}<a href="/keys">ssh keys</a>{{end}}
      <a href="/tokens"{{if eq .View.Section "tokens"}} aria-current="page"{{end}}>agent tokens</a>
      <a href="/docs/agents"{{if eq .View.Section "docs"}} aria-current="page"{{end}}>docs</a>
      {{- if .View.SignedIn}}
      {{if .View.Who}}<span class="who">{{.View.Who}}</span>{{end}}
      <form method="post" action="/sign-out">
        <input type="hidden" name="{{.View.CSRFField}}" value="{{.View.CSRF}}">
        <button type="submit">sign out</button>
      </form>
      {{- else}}
      <a href="/sign-in">sign in</a>
      {{- end}}
    </nav>
  </header>
{{template "main" .}}
{{- with .View.Alternates}}
<footer class="machine">
  <span class="label">machine</span>
  {{- range .}}
  <a class="format" href="{{.Href}}">{{.Name}}</a>
  {{- end}}
</footer>
{{- end}}
</div>
</body>
</html>
{{- end -}}

{{- /* The mark is the installation's, not the software's: it is drawn only
       when an operator asked for one by name, and only in the masthead,
       which is the one place the interface states its identity. It is
       Latere's own mark, inline so it needs no fetch, in currentColor so it
       is ink in both themes, and sized in attributes so it is the right
       size before the stylesheet arrives and if it never does.

       It is decorative: the name beside it is the accessible name, and a
       second one would be read twice. */ -}}
{{- define "mark" -}}
<svg class="mark" viewBox="147 279 736 425" width="35" height="20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><g transform="translate(0 1024) scale(0.1 -0.1)">
      <path d="M7281 7439 c-263 -25 -575 -124 -883 -280 -385 -196 -764 -463 -1133 -799 -163 -148 -575 -562 -702 -704 -315 -353 -539 -670 -638 -905 -19 -45 -35 -87 -35 -93 0 -6 22 23 48 63 168 256 665 790 1042 1120 638 557 1244 947 1735 1115 304 105 506 139 760 131 175 -6 239 -17 385 -63 103 -32 144 -52 238 -117 225 -155 371 -428 402 -751 35 -378 -122 -885 -405 -1311 -209 -314 -531 -641 -865 -882 -505 -364 -1124 -588 -1747 -633 -196 -14 -423 -1 -648 36 -166 28 -381 81 -464 113 -82 33 -73 17 15 -27 387 -193 909 -283 1409 -242 878 73 1740 531 2341 1245 348 413 589 914 670 1390 23 136 24 434 1 566 -68 393 -280 698 -607 872 -244 130 -585 188 -919 156z" />
      <path d="M3790 7343 c-199 -13 -403 -45 -550 -84 -738 -199 -1279 -609 -1578 -1197 -73 -143 -122 -285 -159 -457 -24 -118 -27 -149 -26 -330 0 -175 3 -215 26 -321 59 -279 177 -525 353 -734 325 -388 794 -609 1348 -637 313 -15 763 72 1096 212 262 110 529 267 730 428 99 80 286 263 365 357 57 68 155 210 155 224 0 4 -43 -32 -96 -78 -286 -251 -789 -554 -1129 -679 -629 -232 -1234 -231 -1698 3 -127 64 -211 123 -311 219 -217 210 -357 460 -422 761 -15 68 -19 127 -19 290 0 186 3 215 27 315 171 719 788 1271 1658 1484 488 119 948 121 1424 6 55 -13 102 -23 103 -21 6 6 -184 85 -277 115 -274 89 -728 145 -1020 124z" />
      <path d="M4355 6874 c-431 -32 -757 -119 -1081 -288 -453 -236 -748 -562 -860 -951 -87 -303 -41 -671 114 -915 170 -269 431 -430 787 -487 140 -22 438 -14 589 16 141 29 289 77 402 133 93 46 209 116 203 123 -2 1 -44 -11 -94 -27 -218 -74 -505 -110 -709 -90 -268 27 -449 86 -641 209 -364 235 -484 682 -295 1099 207 458 718 825 1385 994 444 113 807 127 1130 43 13 -3 17 -2 10 5 -33 32 -307 102 -480 122 -100 11 -382 20 -460 14z" />
      <path d="M7115 6809 c-463 -70 -919 -303 -1510 -775 -518 -413 -995 -938 -1203 -1328 -24 -43 -41 -82 -40 -87 2 -4 38 36 80 89 256 323 656 710 1038 1008 596 465 1139 743 1568 805 118 17 317 7 412 -21 225 -64 378 -206 446 -412 25 -75 28 -98 28 -228 0 -105 -5 -169 -18 -230 -80 -368 -281 -709 -631 -1069 -258 -265 -535 -468 -865 -632 -531 -264 -991 -378 -1539 -380 -210 0 -213 -9 -13 -36 168 -22 500 -22 675 1 333 43 709 152 1027 299 169 77 407 220 570 340 566 418 941 947 1065 1502 25 112 31 372 10 480 -60 317 -255 543 -549 634 -152 47 -389 64 -551 40z" />
      <path d="M6770 6241 c-199 -43 -425 -141 -623 -271 -60 -40 -107 -74 -104 -76 2 -2 42 14 88 35 122 57 334 127 455 151 334 64 544 -32 595 -273 19 -88 6 -238 -30 -346 -40 -118 -133 -301 -218 -428 -198 -297 -501 -598 -818 -811 -264 -177 -470 -272 -845 -391 -59 -18 127 -5 260 19 226 41 432 114 693 247 647 330 1105 859 1233 1424 12 50 17 120 18 214 0 121 -3 149 -23 205 -54 155 -154 253 -305 299 -88 27 -253 28 -376 2z" />
      <path d="M5515 5516 c-58 -27 -116 -82 -142 -135 -14 -27 -18 -59 -18 -131 0 -87 3 -100 30 -148 54 -99 132 -146 245 -146 96 -1 168 32 235 106 168 186 27 478 -230 478 -53 0 -82 -6 -120 -24z" />
    </g></svg>
{{- end -}}

{{- define "stale" -}}
{{if .}}<p class="notice"><strong>This page may be out of date.</strong> The data was last refreshed {{.}} ago.</p>{{end}}
{{- end -}}

{{- define "repohead" -}}
{{- with .Repo}}
<p class="crumbs"><a href="/">repositories</a> / <span class="here">{{.Owner}} / {{.Slug}}</span>{{if ne .Ref .DefaultBranch}} <span class="muted">at</span> <span class="here">{{.Ref}}</span>{{end}}</p>
<nav class="sections" aria-label="Repository sections">
  <a href="{{.URL}}{{.RefQuery}}"{{if eq $.View.Section "overview"}} aria-current="page"{{end}}>overview</a>
  <a href="{{.URL}}/log{{.RefQuery}}"{{if eq $.View.Section "log"}} aria-current="page"{{end}}>log</a>
  <a href="{{.URL}}/tree/{{.RefQuery}}"{{if eq $.View.Section "tree"}} aria-current="page"{{end}}>tree</a>
  <a href="{{.URL}}/refs"{{if eq $.View.Section "refs"}} aria-current="page"{{end}}>references</a>
</nav>
{{- end}}
{{- end -}}

{{- define "diffbody" -}}
<div class="diff-body scroller">
  <table class="diff">
    <caption class="visually-hidden">Diff of {{.Path}}</caption>
    <tbody>
    {{- range .Rows}}
      {{- if .IsHunk}}
      <tr class="hunk"><td class="gutter"></td><td class="gutter"></td><td class="sign"></td><td>{{.Text}}</td></tr>
      {{- else if .IsNote}}
      <tr class="note"><td class="gutter"></td><td class="gutter"></td><td class="sign"></td><td>{{.Text}}</td></tr>
      {{- else if .IsAdd}}
      <tr class="add"><td class="gutter"></td><td class="gutter">{{.New}}</td><td class="sign">+</td><td>{{.Text}}</td></tr>
      {{- else if .IsDel}}
      <tr class="del"><td class="gutter">{{.Old}}</td><td class="gutter"></td><td class="sign">-</td><td>{{.Text}}</td></tr>
      {{- else}}
      <tr><td class="gutter">{{.Old}}</td><td class="gutter">{{.New}}</td><td class="sign"> </td><td>{{.Text}}</td></tr>
      {{- end}}
    {{- end}}
    </tbody>
  </table>
</div>
{{- end -}}

{{- define "difffiles" -}}
{{- range .}}
<div id="{{.ID}}">
{{- if .Binary}}
  <div class="diff-file">
    <div class="diff-head">
      <span class="diff-path">{{.Path}}</span>
      <span class="meta">binary</span>
      <a href="{{.OnlyURL}}">this file only</a>
      {{if .BlobURL}}<a href="{{.BlobURL}}">view file</a>{{end}}
    </div>
  </div>
{{- else if .OverBudget}}
  <div class="diff-file">
    <div class="diff-head">
      <span class="diff-path">{{.Path}}</span>
      <span class="count-add">{{.Additions}}</span>
      <span class="count-del">{{.Deletions}}</span>
    </div>
    <div class="notice">
      <p>{{.Changed}} changed lines. Too large to render inline.</p>
      <p><a href="{{.OnlyURL}}">Show this file only</a> · {{if .BlobURL}}<a href="{{.BlobURL}}">View file</a> · {{end}}{{if .PatchURL}}<a href="{{.PatchURL}}">Download patch</a> · {{end}}<a href="{{.LogURL}}">History</a></p>
    </div>
  </div>
{{- else}}
  <details class="diff-file"{{if not .Collapsed}} open{{end}}>
    <summary>
      <span class="diff-path">{{.Path}}</span>
      <span class="count-add">{{.Additions}}</span>
      <span class="count-del">{{.Deletions}}</span>
      <span class="meta">{{.Status}}</span>
      <a href="{{.OnlyURL}}">this file only</a>
      {{if .BlobURL}}<a href="{{.BlobURL}}">view file</a>{{end}}
    </summary>
    {{template "diffbody" .}}
  </details>
{{- end}}
</div>
{{- end}}
{{- end -}}
